    "minimum_duration_years": 3,
    "saqa_id": "DEMO-00001",
    "outcomes": [
      {"ref": "PO1", "text": "Explain the structure and function of the human body in health and disease.", "domain": "knowledge", "level": "Understand"},
      {"ref": "PO2", "text": "Analyse health information and research evidence to support decisions.", "domain": "knowledge", "level": "Analyze"},
      {"ref": "PO3", "text": "Perform basic clinical and laboratory procedures safely.", "domain": "skill", "level": "Apply"},
      {"ref": "PO4", "text": "Communicate clearly with patients, communities and colleagues.", "domain": "skill", "level": "Apply"},
      {"ref": "PO5", "text": "Act ethically and professionally in health settings.", "domain": "attitude", "level": "Evaluate"},
      {"ref": "PO6", "text": "Work effectively in interprofessional teams.", "domain": "attitude", "level": "Apply"}
    ]
  },
