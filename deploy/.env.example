# Curriculum in Context Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Secret key for session encryption (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-random-string

# Database connection
POSTGRES_USER=ocmp
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=ocmp
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis connection
REDIS_URL=redis://redis:6379/0

# =============================================================================
# OPTIONAL: SESSIONS AND SIGN-IN
# =============================================================================

# Session lifetime in hours (sliding: renewed on each request)
# SESSION_EXPIRE_HOURS=24

# Only set to false for local development over plain HTTP
# SESSION_COOKIE_SECURE=true

# Sign-in attempts allowed per client address per 15-minute window
# LOGIN_RATE_LIMIT_PER_IP=20

# Per account, failed sign-ins slow down further attempts (never a lockout):
# after LOGIN_DELAY_FREE_FAILURES failures, each attempt waits BASE seconds,
# doubling per further failure up to MAX seconds.
# LOGIN_DELAY_FREE_FAILURES=3
# LOGIN_DELAY_BASE_SECONDS=1
# LOGIN_DELAY_MAX_SECONDS=20

# Reverse proxies trusted to report the client address via X-Forwarded-For
# (comma-separated IPs, CIDR networks or hostnames). Defaults to the Caddy service.
# TRUSTED_PROXIES=caddy

# =============================================================================
# OPTIONAL: EMAIL (required for password reset)
# =============================================================================

# Public address of the site, used in links in emails (default: https://$DOMAIN)
# PUBLIC_URL=https://curriculum.example.ac.za

# For local development, start the mail catcher with
#   docker compose --profile mailpit up -d
# and use SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_TLS=false (UI: http://localhost:8025)

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=Curriculum in Context
# SMTP_TLS=true            # STARTTLS, usually port 587
# SMTP_SSL=false           # implicit TLS, usually port 465

# Password reset links expire after this many minutes
# PASSWORD_RESET_TOKEN_MINUTES=60

# =============================================================================
# OPTIONAL: OIDC AUTHENTICATION
# =============================================================================

# Register Curriculum in Context with your identity provider as a confidential "Web" client with
# redirect URI:  https://<your domain>/api/v1/auth/oidc/callback
# Use your tenant-specific discovery URL (Entra's multi-tenant /common endpoint is not
# supported). People are matched by the provider's subject id, never by email.
# OIDC_ENABLED=false
# OIDC_PROVIDER_NAME=Microsoft Entra ID
# OIDC_DISCOVERY_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# Create accounts on first SSO sign-in (they have no roles until assigned)
# OIDC_AUTO_PROVISION=true

# =============================================================================
# OPTIONAL: AI PROVIDERS AND SECRETS
# =============================================================================

# AI is off until an administrator chooses a provider in Admin > AI settings. The provider,
# its API key (stored encrypted), budgets and local-only mode are set there, not here.

# Keys that encrypt stored secrets such as AI provider keys, newest first, comma-separated.
# Make one with: docker compose exec api python -m app.cli new-encryption-key
# REQUIRED on a server (ENVIRONMENT=production): without it a new AI key cannot be saved.
# Only with ENVIRONMENT=development may it stay empty (a key is then derived from SECRET_KEY).
# Keep these with your backups.
# To change: put the new key first, keep the old one after it, restart, then run
#   docker compose exec api python -m app.cli rotate-secrets
# SECRETS_ENCRYPTION_KEYS=

# Stored AI prompts and responses are cleared after this many days (0 = keep).
# Run records, token counts and the links they produced are always kept.
# Clear them with: docker compose exec api python -m app.cli purge-ai-content
# AI_CALL_RETENTION_DAYS=365

# =============================================================================
# OPTIONAL: AUDIT LOG
# =============================================================================

# Audit log entries are deleted after this many days (0 = keep forever).
# Delete them with: docker compose exec api python -m app.cli purge-audit-log
# AUDIT_LOG_RETENTION_DAYS=0

# Framework pack import: the largest file accepted (megabytes) and the most items
# in one pack. Raise them for big vocabularies; 20 000 items took about 20
# seconds to import on a development computer.
# PACK_MAX_UPLOAD_MB=10
# PACK_MAX_ITEMS=20000

# =============================================================================
# OPTIONAL: EMBEDDINGS
# =============================================================================

# Not used before Phase 1. The local embedding model runs in the optional
# `embeddings` profile (off by default; its image is not published yet).
# EMBEDDINGS_LOCAL=false
# EMBEDDINGS_LOCAL_URL=http://embeddings:8080

# Or use OpenAI embeddings
# EMBEDDINGS_OPENAI=false
# EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small

# =============================================================================
# OPTIONAL: DEPLOYMENT
# =============================================================================

# Domain for Caddy auto-HTTPS (leave empty for localhost)
# DOMAIN=curriculum.example.ac.za

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# production (default, for servers) or development. In production an AI provider key can only
# be saved when SECRETS_ENCRYPTION_KEYS is set (see the AI section below).
# ENVIRONMENT=production

# Released images from GitHub Container Registry instead of building locally
# (then use `docker compose pull` and `up -d` without --build). See the upgrade guide.
# OCMP_BACKEND_IMAGE=ghcr.io/openaudire/ocmp-backend:0.2.0
# OCMP_WEB_IMAGE=ghcr.io/openaudire/ocmp-web:0.2.0

# =============================================================================
# ENCRYPTION KEY FOR CONNECTOR SECRETS
# =============================================================================

# Generate with: openssl rand -hex 32
# CONNECTOR_ENCRYPTION_KEY=change-me-to-a-random-string
