# OCMP Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Secret key for session encryption (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-random-string

# Database connection
POSTGRES_USER=ocmp
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=ocmp
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis connection
REDIS_URL=redis://redis:6379/0

# =============================================================================
# OPTIONAL: SESSIONS AND SIGN-IN
# =============================================================================

# Session lifetime in hours (sliding: renewed on each request)
# SESSION_EXPIRE_HOURS=24

# Only set to false for local development over plain HTTP
# SESSION_COOKIE_SECURE=true

# Sign-in attempts allowed per client address per 15-minute window
# LOGIN_RATE_LIMIT_PER_IP=20

# Per account, failed sign-ins slow down further attempts (never a lockout):
# after LOGIN_DELAY_FREE_FAILURES failures, each attempt waits BASE seconds,
# doubling per further failure up to MAX seconds.
# LOGIN_DELAY_FREE_FAILURES=3
# LOGIN_DELAY_BASE_SECONDS=1
# LOGIN_DELAY_MAX_SECONDS=20

# Reverse proxies trusted to report the client address via X-Forwarded-For
# (comma-separated IPs, CIDR networks or hostnames). Defaults to the Caddy service.
# TRUSTED_PROXIES=caddy

# =============================================================================
# OPTIONAL: EMAIL (required for password reset)
# =============================================================================

# Public address of the site, used in links in emails (default: https://$DOMAIN)
# PUBLIC_URL=https://curriculum.example.ac.za

# For local development, start the mail catcher with
#   docker compose --profile mailpit up -d
# and use SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_TLS=false (UI: http://localhost:8025)

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=OCMP
# SMTP_TLS=true            # STARTTLS, usually port 587
# SMTP_SSL=false           # implicit TLS, usually port 465

# Password reset links expire after this many minutes
# PASSWORD_RESET_TOKEN_MINUTES=60

# =============================================================================
# OPTIONAL: OIDC AUTHENTICATION
# =============================================================================

# Register OCMP with your identity provider as a confidential "Web" client with
# redirect URI:  https://<your domain>/api/v1/auth/oidc/callback
# Use your tenant-specific discovery URL (Entra's multi-tenant /common endpoint is not
# supported). People are matched by the provider's subject id, never by email.
# OIDC_ENABLED=false
# OIDC_PROVIDER_NAME=Microsoft Entra ID
# OIDC_DISCOVERY_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# Create accounts on first SSO sign-in (they have no roles until assigned)
# OIDC_AUTO_PROVISION=true

# =============================================================================
# OPTIONAL: AI PROVIDERS
# =============================================================================

# AI_ENABLED=false

# Anthropic Claude
# AI_ANTHROPIC_API_KEY=

# OpenAI-compatible (OpenAI, Azure OpenAI, etc.)
# AI_OPENAI_API_KEY=
# AI_OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama
# AI_OLLAMA_BASE_URL=http://ollama:11434

# Monthly budget cap in USD (0 = unlimited)
# AI_MONTHLY_BUDGET_CAP=100

# Stored AI prompts and responses are cleared after this many days (0 = keep).
# Run records, token counts and the links they produced are always kept.
# Clear them with: docker compose exec api python -m app.cli purge-ai-content
# AI_CALL_RETENTION_DAYS=365

# =============================================================================
# OPTIONAL: EMBEDDINGS
# =============================================================================

# Use local embedding model (requires embeddings container)
# EMBEDDINGS_LOCAL=true
# EMBEDDINGS_LOCAL_URL=http://embeddings:8080

# Or use OpenAI embeddings
# EMBEDDINGS_OPENAI=false
# EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small

# =============================================================================
# OPTIONAL: DEPLOYMENT
# =============================================================================

# Domain for Caddy auto-HTTPS (leave empty for localhost)
# DOMAIN=curriculum.example.ac.za

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# ENCRYPTION KEY FOR CONNECTOR SECRETS
# =============================================================================

# Generate with: openssl rand -hex 32
# CONNECTOR_ENCRYPTION_KEY=change-me-to-a-random-string
