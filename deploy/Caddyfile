# Curriculum in Context Caddyfile
# Caddy provides automatic HTTPS with Let's Encrypt

{$DOMAIN:localhost} {
    # Local additions such as your own TLS certificate: *.caddy files in deploy/caddy/
    # (see deploy/caddy/README.md). None are shipped; a missing match is not an error.
    import /etc/caddy/site.d/*.caddy

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains" defer
    }

    # A study guide is at most 10 MB (the API says so too). Stopping a larger upload here means
    # it is not received and written to disk first.
    @study_guide_upload path_regexp ^/api/v1/modules/[^/]+/study-guides$
    request_body @study_guide_upload {
        max_size 11MB
    }

    # API routes
    handle /api/* {
        reverse_proxy api:8000
    }

    # Health check (no auth required)
    handle /health {
        reverse_proxy api:8000
    }

    handle /ready {
        reverse_proxy api:8000
    }

    # Frontend (static files)
    handle {
        reverse_proxy web:80
    }

    # Enable gzip compression
    encode gzip

    # Logging. OAuth/OIDC callback parameters are redacted: authorization codes and
    # state values must not be stored in access logs (RFC 9700 section 4.2).
    log {
        output stdout
        format filter {
            wrap json
            request>uri query {
                replace code REDACTED
                replace state REDACTED
            }
        }
    }
}
